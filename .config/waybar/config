[
{
    "name": "top-bar",
    "layer": "top",
    "position": "top",
    "height": 28,
    "output": ["DP-1", "DP-2"],
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/prev", "mpris", "custom/pause", "custom/next"],
    "modules-right": ["memory", "cpu", "temperature", "custom/gpuusage", "custom/gputemp"],

    "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false, // This ensures Monitor 1 doesn't show Monitor 2's workspaces
    "persistent-workspaces": {
        "DP-1": [1, 2, 3], // Workspaces 1, 2, and 3 will always stay on DP-1[cite: 17]
        "DP-2": [4, 5, 6]  // Workspaces 4, 5, and 6 will always stay on DP-2[cite: 17]
    }
},

    "mpris": {
        "format": "{player_icon} {title}",
        "player-icons": { "default": "󰎆" },
        "on-click": "python3 /home/creed/.config/waybar/modules/mediaplayer_popup.py"
    },
    "custom/prev": { "format": "󰒮", "on-click": "playerctl previous", "tooltip": false },
    "custom/pause": {
        "exec": "playerctl status 2>/dev/null | grep -q Playing && echo '' || echo ''",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },
    "custom/next": { "format": "󰒭", "on-click": "playerctl next", "tooltip": false },

    "cpu": {
    "format": "CPU {usage}%", // Removed leading spaces[cite: 17]
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/toggle-sysinfo.sh"
},
"temperature": {
    "format": "{temperatureC}°C", // Removed leading spaces[cite: 17]
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/toggle-sysinfo.sh"
},
"custom/gpuusage": {
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -1 | xargs printf 'GPU %s%%'", // Removed leading spaces[cite: 17]
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/toggle-sysinfo.sh"
},
"custom/gputemp": {
    "exec": "sensors | grep -A0 'junction' | head -1 | awk '{print $2}' | tr -d '+°C' | xargs printf '%s°C'", // Removed leading spaces[cite: 17]
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/toggle-sysinfo.sh"
},
"memory": {
    "format": "RAM {percentage}%", // Removed leading spaces[cite: 17]
    "interval": 3,
    "on-click": "~/.config/hypr/scripts/toggle-sysinfo.sh"
},

},
{
    "name": "bottom-bar",
    "layer": "top",
    "position": "bottom",
    "height": 28,
    "output": ["DP-1", "DP-2"],
    "modules-left": ["custom/power", "custom/launcher"],
    "modules-center": ["custom/firefox", "custom/steam", "custom/vesktop", "custom/dolphin", "custom/youtubemusic", "custom/settings"],
    "modules-right": ["tray", "wireplumber", "network", "clock"],

    "custom/power": {
        "format": "",
        "on-click": "wlogout --protocol xdg --no-span --layout ~/.config/wlogout/layout --css ~/.config/wlogout/style.css -b 1 -L 20 -R 2200 -T 1100 -B 40 --buttons-per-row 3"
    },
    "tray": { "icon-size": 15, "spacing": 10, "show-passive-items": true },
    "custom/launcher":     { "format": "󰀻", "on-click": "wofi --show drun --style ~/.config/wofi/style.css" },
    "custom/firefox":      { "format": "", "on-click": "firefox" },
    "custom/steam":        { "format": "", "on-click": "steam" },
    "custom/vesktop":      { "format": "", "on-click": "vesktop" },
    "custom/dolphin":      { "format": "󰉋", "on-click": "dolphin" },
    "custom/youtubemusic": { "format": "󰎆", "on-click": "youtubemusic" },
    "custom/settings":     { "format": "", "on-click": "dolphin ~/.config/hypr/"},
    "network": {
    "format-wifi": "  Connected",
    "format-ethernet": " Connected",
    "format-disconnected": "󰤮 Disconnected",
    "tooltip": false,
    "on-click": "/home/creed/.config/hypr/scripts/toggle-network.sh"
},
    "wireplumber": {
        "format": "󰕾 {volume}%",
        "format-icons": ["", "", ""],
        "on-click": "python3 /home/creed/.config/waybar/modules/volume_popup.py --cx $(hyprctl cursorpos | cut -d',' -f1) --cy $(hyprctl cursorpos | cut -d',' -f2)"
    },
    "clock": { "format": " {:%d/%m/%Y  %H:%M}", "on-click": "~/.config/hypr/scripts/toggle-calendar.sh" }
}
]
